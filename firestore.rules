rules_version = '2';

// Muévete Firestore rules. Copied from the rules published in the Firebase
// console on 2026-11-10, plus `allow delete: if isOwner(uid);` on
// users/{uid} so a user can delete their own data from Settings (v1.3.0).
// This file is not deployed automatically: check it in the Rules Playground
// and publish it from the console. Publishing replaces all rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Set only through the Admin SDK (panel script), never by users.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      // Account deletion from Settings. The document has no subcollections.
      allow delete: if isOwner(uid);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['username', 'age', 'height', 'weight', 'sex', 'createdAt']);
    }

    // Content: signed-in users read it; only admins write it. The upload
    // scripts use the service account, which bypasses these rules.
    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /plans/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /active_breaks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /achievements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /educational_messages/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /progression_rules/{id} {
      allow read: if signedIn();
    }
    match /questions/{id} {
      allow read: if signedIn();
    }
    // Read by app versions before 1.3.0; remove once nobody uses them.
    match /preguntas/{id} {
      allow read: if signedIn();
    }

    match /admin_audit/{id} {
      allow read: if isAdmin();
    }
  }
}
