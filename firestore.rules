rules_version = '2';

// Muévete Firestore rules, shared by the mobile app and this admin panel.
// Keep this file identical to `firestore.rules` in the app repository
// (DavidSWB/muevete), which is the copy that gets published.
// Not deployed automatically: `firebase deploy --only firestore:rules`
// replaces every rule in the project, so review before publishing.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Set only with the Admin SDK (functions/scripts/set-admin-claim.mjs).
    // Claims live in the Auth token, so users cannot grant it to themselves.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // A consent record on a profile (`policyAccepted`,
    // `healthDataAuthorization`): exactly {version, date}, a version that
    // has been published, and the server time of this very write, so the
    // date is proof of when the user accepted.
    function validConsentRecord(record) {
      return record is map
        && record.keys().hasOnly(['version', 'date'])
        && record.keys().hasAll(['version', 'date'])
        && record.version is int
        && record.version >= 1
        && record.version <= get(/databases/$(database)/documents/policies/privacy).data.currentVersion
        && record.date == request.time;
    }

    // Writes that leave both consent records untouched are not checked
    // here, so every other profile write behaves as before. Removing a
    // record is refused.
    function consentRecordsValid() {
      let changed = resource == null
        ? request.resource.data.keys()
        : request.resource.data.diff(resource.data).affectedKeys();
      return (!('policyAccepted' in changed)
          || validConsentRecord(request.resource.data.policyAccepted))
        && (!('healthDataAuthorization' in changed)
          || validConsentRecord(request.resource.data.healthDataAuthorization));
    }

    // Personal data: only the owner, never admins. The app creates the
    // profile at sign-up, updates it, and deletes it from Settings
    // (account deletion is a legal requirement). No subcollections.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && consentRecordsValid();
    }

    // The privacy policy and its versions. Public, because it is shown
    // before an account exists. Published only with the Admin SDK
    // (tool/publish_policy), which bypasses these rules; no app writes it.
    match /policies/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Content the app reads: signed-in users read it, only admins write it.
    // The panel validates every document against the app's data model.
    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /plans/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /active_breaks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /questions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /progression_rules/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /educational_messages/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /achievements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Read by app versions before 1.3.0; remove once nobody uses them.
    match /preguntas/{id} {
      allow read: if signedIn();
    }

    // Append-only log of content changes made from the panel.
    match /admin_audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['actorUid', 'actorEmail', 'action', 'collection', 'docId', 'at', 'before', 'after'])
        && request.resource.data.keys().hasAll(['actorUid', 'action', 'collection', 'docId', 'at'])
        && request.resource.data.actorUid == request.auth.uid
        && (!('actorEmail' in request.resource.data)
            || request.resource.data.actorEmail == request.auth.token.email)
        && request.resource.data.action in ['create', 'update', 'delete']
        && request.resource.data.collection in ['exercises', 'plans', 'active_breaks', 'questions',
             'progression_rules', 'educational_messages', 'achievements']
        && request.resource.data.docId is string
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
